{
  "description": "Suite 4a, comparison semantics (FR-RUL-003, FR-RUL-006 to FR-RUL-009, ADR-017, ADR-019). Each case is one targeting rule on the attribute named by 'attribute' (default 'attr'), evaluated against 'attributes'. 'expected' is 'match', 'no-match', or 'malformed' for a rule the engine cannot apply. The Java engine and the TypeScript SDK both run every case.",
  "cases": [
    { "name": "EQUALS matches an identical string", "operator": "EQUALS", "matchValues": ["US"], "attributes": { "attr": "US" }, "expected": "match" },
    { "name": "EQUALS never matches an absent attribute", "operator": "EQUALS", "matchValues": ["US"], "attributes": {}, "expected": "no-match" },
    { "name": "EQUALS never matches an attribute of another type", "operator": "EQUALS", "matchValues": ["true"], "attributes": { "attr": true }, "expected": "no-match" },
    { "name": "EQUALS is case-sensitive", "operator": "EQUALS", "matchValues": ["US"], "attributes": { "attr": "us" }, "expected": "no-match" },
    { "name": "EQUALS: the number 1 never equals the string \"1\"", "operator": "EQUALS", "matchValues": ["1"], "attributes": { "attr": 1 }, "expected": "no-match" },
    { "name": "EQUALS: the string \"1\" never equals the number 1", "operator": "EQUALS", "matchValues": [1], "attributes": { "attr": "1" }, "expected": "no-match" },
    { "name": "EQUALS: 1 equals 1.0", "operator": "EQUALS", "matchValues": [1], "attributes": { "attr": 1.0 }, "expected": "match" },
    { "name": "EQUALS matches a boolean", "operator": "EQUALS", "matchValues": [false], "attributes": { "attr": false }, "expected": "match" },
    { "name": "EQUALS does not normalise Unicode", "operator": "EQUALS", "matchValues": ["café"], "attributes": { "attr": "café" }, "expected": "no-match" },
    { "name": "EQUALS ignores an array attribute", "operator": "EQUALS", "matchValues": ["US"], "attributes": { "attr": ["US"] }, "expected": "no-match" },

    { "name": "NOT_EQUALS matches a different string", "operator": "NOT_EQUALS", "matchValues": ["US"], "attributes": { "attr": "LK" }, "expected": "match" },
    { "name": "NOT_EQUALS does not match an identical string", "operator": "NOT_EQUALS", "matchValues": ["US"], "attributes": { "attr": "US" }, "expected": "no-match" },
    { "name": "NOT_EQUALS never matches an absent attribute", "operator": "NOT_EQUALS", "matchValues": ["US"], "attributes": {}, "expected": "no-match" },
    { "name": "NOT_EQUALS matches an attribute of another type", "operator": "NOT_EQUALS", "matchValues": ["true"], "attributes": { "attr": true }, "expected": "match" },
    { "name": "NOT_EQUALS is case-sensitive", "operator": "NOT_EQUALS", "matchValues": ["US"], "attributes": { "attr": "us" }, "expected": "match" },
    { "name": "NOT_EQUALS: the number 1 is not the string \"1\"", "operator": "NOT_EQUALS", "matchValues": ["1"], "attributes": { "attr": 1 }, "expected": "match" },
    { "name": "NOT_EQUALS ignores an array attribute", "operator": "NOT_EQUALS", "matchValues": ["US"], "attributes": { "attr": ["LK"] }, "expected": "no-match" },
    { "name": "NOT_EQUALS ignores a null attribute", "operator": "NOT_EQUALS", "matchValues": ["US"], "attributes": { "attr": null }, "expected": "no-match" },

    { "name": "IN matches a listed string", "operator": "IN", "matchValues": ["LK", "IN"], "attributes": { "attr": "LK" }, "expected": "match" },
    { "name": "IN never matches an absent attribute", "operator": "IN", "matchValues": ["LK"], "attributes": {}, "expected": "no-match" },
    { "name": "IN never matches an attribute of another type", "operator": "IN", "matchValues": ["1", "2"], "attributes": { "attr": 1 }, "expected": "no-match" },
    { "name": "IN is case-sensitive", "operator": "IN", "matchValues": ["LK"], "attributes": { "attr": "lk" }, "expected": "no-match" },
    { "name": "IN matches a listed number", "operator": "IN", "matchValues": [1, 2, 3], "attributes": { "attr": 2 }, "expected": "match" },
    { "name": "IN: the string \"1\" is not in a list of numbers", "operator": "IN", "matchValues": [1, 2], "attributes": { "attr": "1" }, "expected": "no-match" },
    { "name": "IN ignores an object attribute", "operator": "IN", "matchValues": ["LK"], "attributes": { "attr": { "country": "LK" } }, "expected": "no-match" },

    { "name": "NOT_IN matches an unlisted string", "operator": "NOT_IN", "matchValues": ["LK"], "attributes": { "attr": "US" }, "expected": "match" },
    { "name": "NOT_IN does not match a listed string", "operator": "NOT_IN", "matchValues": ["LK", "US"], "attributes": { "attr": "US" }, "expected": "no-match" },
    { "name": "NOT_IN never matches an absent attribute", "operator": "NOT_IN", "matchValues": ["LK"], "attributes": {}, "expected": "no-match" },
    { "name": "NOT_IN matches an attribute of another type", "operator": "NOT_IN", "matchValues": ["1"], "attributes": { "attr": 1 }, "expected": "match" },
    { "name": "NOT_IN is case-sensitive", "operator": "NOT_IN", "matchValues": ["LK"], "attributes": { "attr": "lk" }, "expected": "match" },
    { "name": "NOT_IN ignores an array attribute", "operator": "NOT_IN", "matchValues": ["LK"], "attributes": { "attr": ["US"] }, "expected": "no-match" },

    { "name": "CONTAINS matches a substring", "operator": "CONTAINS", "matchValues": ["@example.com"], "attributes": { "attr": "amara@example.com" }, "expected": "match" },
    { "name": "CONTAINS never matches an absent attribute", "operator": "CONTAINS", "matchValues": ["@example.com"], "attributes": {}, "expected": "no-match" },
    { "name": "CONTAINS never matches a number attribute", "operator": "CONTAINS", "matchValues": ["1"], "attributes": { "attr": 12 }, "expected": "no-match" },
    { "name": "CONTAINS never matches with a number operand", "operator": "CONTAINS", "matchValues": [1], "attributes": { "attr": "12" }, "expected": "no-match" },
    { "name": "CONTAINS is case-sensitive", "operator": "CONTAINS", "matchValues": ["Example"], "attributes": { "attr": "amara@example.com" }, "expected": "no-match" },
    { "name": "CONTAINS matches a non-ASCII substring", "operator": "CONTAINS", "matchValues": ["සඳ"], "attributes": { "attr": "සඳුනි" }, "expected": "match" },
    { "name": "CONTAINS: every string contains the empty string", "operator": "CONTAINS", "matchValues": [""], "attributes": { "attr": "x" }, "expected": "match" },

    { "name": "STARTS_WITH matches a prefix", "operator": "STARTS_WITH", "matchValues": ["u-"], "attributes": { "attr": "u-1042" }, "expected": "match" },
    { "name": "STARTS_WITH never matches an absent attribute", "operator": "STARTS_WITH", "matchValues": ["u-"], "attributes": {}, "expected": "no-match" },
    { "name": "STARTS_WITH never matches a number attribute", "operator": "STARTS_WITH", "matchValues": ["1"], "attributes": { "attr": 12 }, "expected": "no-match" },
    { "name": "STARTS_WITH never matches a boolean attribute", "operator": "STARTS_WITH", "matchValues": ["t"], "attributes": { "attr": true }, "expected": "no-match" },
    { "name": "STARTS_WITH is case-sensitive", "operator": "STARTS_WITH", "matchValues": ["U-"], "attributes": { "attr": "u-1042" }, "expected": "no-match" },
    { "name": "STARTS_WITH matches a prefix outside the Basic Multilingual Plane", "operator": "STARTS_WITH", "matchValues": ["😀"], "attributes": { "attr": "😀abc" }, "expected": "match" },

    { "name": "ENDS_WITH matches a suffix", "operator": "ENDS_WITH", "matchValues": [".lk"], "attributes": { "attr": "shop.example.lk" }, "expected": "match" },
    { "name": "ENDS_WITH never matches an absent attribute", "operator": "ENDS_WITH", "matchValues": [".lk"], "attributes": {}, "expected": "no-match" },
    { "name": "ENDS_WITH never matches a number attribute", "operator": "ENDS_WITH", "matchValues": ["2"], "attributes": { "attr": 12 }, "expected": "no-match" },
    { "name": "ENDS_WITH is case-sensitive", "operator": "ENDS_WITH", "matchValues": [".LK"], "attributes": { "attr": "shop.example.lk" }, "expected": "no-match" },
    { "name": "ENDS_WITH matches a combining mark as written", "operator": "ENDS_WITH", "matchValues": ["́"], "attributes": { "attr": "café" }, "expected": "match" },
    { "name": "ENDS_WITH does not normalise Unicode", "operator": "ENDS_WITH", "matchValues": ["é"], "attributes": { "attr": "café" }, "expected": "no-match" },

    { "name": "A regular-expression operator is malformed", "operator": "MATCHES_REGEX", "matchValues": ["^u-"], "attributes": { "attr": "u-1" }, "expected": "malformed" },
    { "name": "An operator name in the wrong case is malformed", "operator": "equals", "matchValues": ["US"], "attributes": { "attr": "US" }, "expected": "malformed" },
    { "name": "A rule with no operator is malformed", "operator": null, "matchValues": ["US"], "attributes": { "attr": "US" }, "expected": "malformed" },
    { "name": "An empty value list is malformed", "operator": "IN", "matchValues": [], "attributes": { "attr": "US" }, "expected": "malformed" },
    { "name": "A missing value list is malformed", "operator": "EQUALS", "matchValues": null, "attributes": { "attr": "US" }, "expected": "malformed" },
    { "name": "A null match value is malformed", "operator": "IN", "matchValues": ["LK", null], "attributes": { "attr": "LK" }, "expected": "malformed" },
    { "name": "An array match value is malformed", "operator": "IN", "matchValues": [["LK"]], "attributes": { "attr": "LK" }, "expected": "malformed" },
    { "name": "An object match value is malformed", "operator": "EQUALS", "matchValues": [{ "country": "LK" }], "attributes": { "attr": "LK" }, "expected": "malformed" },
    { "name": "EQUALS with two values is malformed", "operator": "EQUALS", "matchValues": ["LK", "US"], "attributes": { "attr": "LK" }, "expected": "malformed" },
    { "name": "CONTAINS with two values is malformed", "operator": "CONTAINS", "matchValues": ["a", "b"], "attributes": { "attr": "ab" }, "expected": "malformed" },
    { "name": "IN with values of two types is malformed", "operator": "IN", "matchValues": ["1", 1], "attributes": { "attr": 1 }, "expected": "malformed" },
    { "name": "NOT_IN with values of two types is malformed", "operator": "NOT_IN", "matchValues": [true, "true"], "attributes": { "attr": "x" }, "expected": "malformed" },
    { "name": "A rule on an empty attribute name is malformed", "attribute": "", "operator": "EQUALS", "matchValues": ["US"], "attributes": { "": "US" }, "expected": "malformed" },
    { "name": "A rule with no attribute name is malformed", "attribute": null, "operator": "EQUALS", "matchValues": ["US"], "attributes": { "attr": "US" }, "expected": "malformed" },
    { "name": "A malformed rule is malformed even when the attribute is absent", "operator": "MATCHES_REGEX", "matchValues": ["x"], "attributes": {}, "expected": "malformed" }
  ]
}
