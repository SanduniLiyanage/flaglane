<?xml version="1.0" encoding="UTF-8"?>
<!--
  Findings SpotBugs is asked not to report, each with the reason. Keep this list short: an
  exclusion is a claim that the detector is wrong here, and every entry is reviewed as such.
-->
<FindBugsFilter>
  <!--
    The Testcontainers fixture connects to a throwaway container as each of the two database
    roles. Its passwords exist only for the lifetime of that container and are not secrets.
  -->
  <Match>
    <Class name="io.github.sanduniliyanage.flaglane.FlaglanePostgres" />
    <Bug pattern="DMI_CONSTANT_DB_PASSWORD" />
  </Match>

  <!--
    Constructor injection. Services, controllers and the tenant resolver receive Spring-managed
    singletons (repositories, other services, JdbcTemplate) that are shared on purpose; holding the
    reference is the point; the audit trail reader is a repository built on JdbcTemplate, as the
    tenant resolver is. SpotBugs guesses mutability from method names such as delete() and
    reports every such constructor. Limited to constructors, in the packages where injection is
    all a constructor does, and to the test client that wraps the test's own HTTP client. Value
    objects and entities are not covered: they copy what they keep.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2" />
    <Method name="&lt;init&gt;" />
    <Or>
      <Package name="~io\.github\.sanduniliyanage\.flaglane\.[a-z]+\.(service|web)" />
      <Class name="io.github.sanduniliyanage.flaglane.common.tenancy.TenantResolver" />
      <Class name="io.github.sanduniliyanage.flaglane.audit.persistence.AuditTrailReader" />
      <Class name="io.github.sanduniliyanage.flaglane.ManagementApiClient" />
    </Or>
  </Match>
</FindBugsFilter>
