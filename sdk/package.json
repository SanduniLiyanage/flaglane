{
  "name": "@flaglane/sdk",
  "version": "0.1.0",
  "description": "Flaglane feature flags, evaluated in process from a ruleset the Flaglane server serves. Keeps answering when Flaglane is down.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanduniLiyanage/flaglane.git",
    "directory": "sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:bench": "tsc -p tsconfig.bench.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "bench:evaluation": "npm run build && node bench/evaluation.ts",
    "bench:serving": "npm run build && node bench/serving.ts",
    "bench:propagation": "npm run build && node bench/propagation.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
