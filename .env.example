# Copy to .env and set every value. .env is gitignored; this file is the only one committed.
# Compose refuses to start while any of these is empty.

# Bootstrap superuser of the PostgreSQL container. Used only to initialise the data volume;
# the application never connects with it.
POSTGRES_PASSWORD=

# Owns the schema and runs Flyway at startup.
FLAGLANE_DB_MIGRATOR_PASSWORD=

# Runs the application. No DDL privileges.
FLAGLANE_DB_APP_PASSWORD=

# Optional. Host port PostgreSQL is published on, for ./gradlew bootRun and psql. Change it if
# something on this machine already listens on 5432; the API inside Compose is unaffected.
# FLAGLANE_DB_PORT=5432
