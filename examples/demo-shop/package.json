{
  "name": "flaglane-demo-shop",
  "version": "0.1.0",
  "private": true,
  "description": "A small storefront whose checkout and shipping banner are decided by Flaglane flags.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "flag": "node --env-file-if-exists=.env src/flag.ts",
    "verify": "node --env-file-if-exists=.env src/verify.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@flaglane/sdk": "file:../../sdk"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
