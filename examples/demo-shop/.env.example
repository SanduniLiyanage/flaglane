# npm run seed writes .env for you; this file documents what it holds. .env is gitignored.

# Where Flaglane runs. Defaults to http://localhost:8080.
# FLAGLANE_URL=http://localhost:8080

# A server key for the demo project's development environment. Seed creates one.
FLAGLANE_SDK_KEY=

# The account seed registers and the flag commands sign in as. Seed generates the password.
FLAGLANE_DEMO_EMAIL=
FLAGLANE_DEMO_PASSWORD=

# The project seed creates. Project keys are unique across the instance, so change it if someone
# else on a shared instance already has demo-shop.
# FLAGLANE_DEMO_PROJECT=demo-shop

# Where the shop listens, and where npm run verify finds it. Defaults to 3000.
# PORT=3000
